{
  "name": "pptr-mcp",
  "version": "0.1.3",
  "description": "MCP server for browser automation via Puppeteer",
  "author": "iatsiuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iatsiuk/pptr-mcp.git"
  },
  "homepage": "https://github.com/iatsiuk/pptr-mcp#readme",
  "bugs": {
    "url": "https://github.com/iatsiuk/pptr-mcp/issues"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "pptr-mcp": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "prebuild": "npm run format && npm run lint && npm run test",
    "build": "tsc",
    "lint": "eslint src/ test/",
    "format": "prettier --write src/ test/",
    "test": "node --import tsx --test --test-concurrency=1 'test/**/*.test.ts' 'test/*.test.ts'",
    "start": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "puppeteer",
    "browser-automation"
  ],
  "license": "WTFPL",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tsconfig/node22": "^22.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "chrome-launcher": "^1.2.1",
    "puppeteer-core": "^24.33.0",
    "zod": "^4.2.1"
  }
}
